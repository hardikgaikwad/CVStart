# =====================================================================
# CVstart Environment Configuration
# Copy this file to .env to override defaults for local development.
# =====================================================================

# Server Settings
CVSTART_HOST=127.0.0.1
CVSTART_PORT=9999
CVSTART_DEBUG=False
CVSTART_SECRET_KEY=local-dev-insecure-key-cvstart-replace-in-production

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3.2

# Compiler Path (optional override if tectonic or pdflatex is not on system PATH)
# TECTONIC_PATH=C:\path\to\tectonic.exe
# PDFLATEX_PATH=C:\path\to\pdflatex.exe

# Workspace Directories (optional override, defaults to workspace/ inside project root)
# CVSTART_WORKSPACE=./workspace
